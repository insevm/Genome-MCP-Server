{
  "name": "genome-bid",
  "version": "0.1.0",
  "description": "Genome NFT auto-bid MCP server — place bids, snipe auctions, and manage your Kernel smart account on Ethereum mainnet.",
  "mcp_server": {
    "transport": "stdio",
    "command": "npx",
    "args": ["genome-bid-mcp"],
    "env": {
      "GENOME_BID_PASSWORD": "${GENOME_BID_PASSWORD}"
    }
  },
  "tools": [
    "get_bid_status",
    "place_bid",
    "start_auto_bid",
    "stop_auto_bid",
    "get_auto_bid_status",
    "snipe_bid",
    "get_snipe_status",
    "stop_snipe",
    "get_bid_history",
    "get_wallet_info",
    "get_floor_price",
    "analyze_auction_history",
    "analyze_bidder",
    "swap_gene",
    "withdraw_eth",
    "withdraw_gene"
  ],
  "setup": {
    "command": "npx genome-bid-mcp setup",
    "docs": "SKILL.md"
  },
  "repository": "https://github.com/insevm/Genome-MCP-Server",
  "license": "MIT"
}
